# Persistent application and session storage. Configure as a Replit Secret;
# never commit the URI or credentials.
MONGODB_URI=
# Required to sign and encrypt sessions and short-lived server tokens.
SESSION_SECRET=
# Operator alert threshold for a sustained MongoDB outage (milliseconds).
MONGODB_OUTAGE_ALERT_THRESHOLD_MS=60000

# Required for foundation quantitative lesson videos and question images.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Email provider: the server reads MAIL_* values and QODRATAK_MAIL_PASSWORD.
MAIL_HOST=mailserver.dmail.sa
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_USER=info@qodratak.sa
QODRATAK_MAIL_PASSWORD=
# Legacy password fallback only; prefer QODRATAK_MAIL_PASSWORD.
SMTP_PASS=
FROM_NAME=مؤسسة قدراتك العالية
# Optional fallback when SMTP is not configured; it is tried before QIROX.
SMTP2GO_API_KEY=
# QIROX email and WhatsApp are enabled only when all three are configured.
QIROX_API_BASE_URL=
QIROX_PROJECT_ID=
QIROX_PROJECT_API_KEY=

# Optional IMAP settings for reading the support mailbox.
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SENT_FOLDER=Sent
MAILBOX_POLL_INTERVAL_MS=30000

# Server-only AI vision provider. Replit AI Integrations supplies these values
# without exposing credentials to the browser. OPENAI_API_KEY remains supported
# for the existing OpenRouter setup.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_MODEL=gpt-4o-mini
